rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Privileged roles must be set by a trusted Admin SDK service as custom claims.
    // A profile document's role is presentation data, never an authority source.
    function platformAdmin() {
      return signedIn() && (request.auth.token.admin == true || request.auth.token.superadmin == true);
    }
    function platformSuperadmin() {
      return signedIn() && request.auth.token.superadmin == true;
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function member(tenantId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }
    function tenantAdmin(tenantId) {
      return platformAdmin() || (member(tenantId) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == 'admin');
    }

    match /users/{userId} {
      allow get: if owner(userId) || platformAdmin();
      allow list: if platformAdmin();
      // New accounts cannot appoint themselves admins or set entitlements.
      allow create: if owner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.permissions == []
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'email', 'avatar', 'role', 'permissions',
          'company', 'telephone', 'createdAt'
        ]);
      allow update: if (owner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'avatar', 'company', 'telephone']))
        || (platformAdmin() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tenantId'])
          || platformSuperadmin()
        ));
      allow delete: if platformAdmin();
      match /eaCanvassTemplates/{templateId} {
        allow read, write: if owner(userId);
      }
    }

    // Legacy private projects: only the creating account can read/list them.
    // Do not allow admins to browse other agencies' projects by default.
    match /projects/{projectId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow get, list, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['projectName', 'address', 'postcode', 'propertyType',
               'bedrooms', 'receptionRooms', 'bathrooms', 'councilTaxBand',
               'purchaseStyles', 'adHighlights', 'adDescription', 'localSummary',
               'measurements', 'roomDescriptions', 'epcData', 'conservationData',
               'valuationReport', 'propertyPhotoUrls', 'floorplanUrl', 'brochureContent']);
    }

    // Tenant document structure for new shared-agency features.
    // Membership is created by an authenticated platform provisioning service.
    match /tenants/{tenantId} {
      allow get: if member(tenantId) || platformAdmin();
      allow list, create, update, delete: if platformSuperadmin();
      match /members/{memberId} {
        allow get: if (memberId == request.auth.uid && signedIn()) || tenantAdmin(tenantId);
        allow list: if tenantAdmin(tenantId);
        allow create, update, delete: if platformSuperadmin();
      }
      match /projects/{projectId} {
        allow get, list: if member(tenantId);
        allow create: if member(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.userId == request.auth.uid;
        allow update: if member(tenantId)
          && resource.data.tenantId == tenantId
          && request.resource.data.tenantId == tenantId
          && request.resource.data.userId == resource.data.userId;
        allow delete: if tenantAdmin(tenantId) ||
          (member(tenantId) && resource.data.userId == request.auth.uid);
      }
    }

    match /companies/{companyId} {
      allow read, write: if platformAdmin();
    }
    match /{settingsCollection}/{docId} {
      allow read: if settingsCollection.matches('settings_.*') && signedIn();
      allow write: if settingsCollection.matches('settings_.*') && platformAdmin();
    }
    match /site_content/{docId} {
      allow read: if true;
      allow write: if platformAdmin();
    }
    match /pricingPlans/{planId} {
      allow read: if true;
      allow write: if platformAdmin();
    }
    match /ctaSection/{docId} {
      allow read: if true;
      allow write: if platformAdmin();
    }
    match /userRequests/{requestId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
