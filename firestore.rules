
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USER PROFILES
    match /users/{userId} {
      // Users can read their own profile. Admins can read any profile.
      allow get: if isOwner(userId) || isAdmin();
      // Users can create their own profile.
      allow create: if isOwner(userId);
      // Users can update their own profile. Admins can update any profile.
      allow update: if isOwner(userId) || isAdmin();
      // Only admins can delete user profiles.
      allow delete: if isAdmin();
      // Admins can list all users.
      allow list: if isAdmin();
    }

    // USER-GENERATED PROJECTS (from EA Analyse & Describe)
    match /projects/{projectId} {
      // A user can create a project.
      allow create: if isSignedIn();
      // A user can read, update, or delete a project they created. Admins can do anything.
      allow read, update, delete: if (resource.data.userId == request.auth.uid) || isAdmin();
      // Users can only list their own projects.
      allow list: if isSignedIn();
    }

    // SETTINGS collections (e.g., room types) - read for all, write for admin
    match /settings_{collection}/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // SITE CONTENT (e.g., homepage hero) - public read, admin write
    match /site_content/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    // PRICING PLANS & CTA - public read, admin write
    match /pricingPlans/{planId} {
       allow get, list: if true;
       allow write: if isAdmin();
    }
     match /ctaSection/{docId} {
       allow get, list: if true;
       allow write: if isAdmin();
    }
    
    // USER REQUESTS - deny all client access, handled by server functions
    match /userRequests/{requestId} {
      allow read, write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
